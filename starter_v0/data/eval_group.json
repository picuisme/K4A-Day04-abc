      "expect": {
        "tool_calls": [
          {
            "name": "approved_software_catalog",
            "args": {
              "query": "Docker Desktop",
              "platform": "windows"
            }
          }
        ]
      },
      "metadata": {
        "skill": "approved_software_routing",
        "difficulty": "medium",
        "what_it_tests": "Câu hỏi về trạng thái phê duyệt phần mềm phải tra catalog thay vì dùng KB chung hoặc tự tuyên bố được cài đặt."
      }
    },
    {
