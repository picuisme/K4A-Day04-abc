{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "10 original IT helpdesk cases created by team abc: 5 single-turn query cases and 5 multi-turn turns cases.",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [
    {
      "id": "G01_format_handoff",
      "phase": "B",
      "suite": "group",
      "query": "Dựa vào finding lỗi RAM DIMM A1, hãy tạo báo cáo handoff với tên 'Lỗi RAM'. Đừng kiểm tra lại.",
      "failure_type": "unnecessary_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "format_incident_report",
            "args": {
              "template": "handoff",
              "incident_title": "Lỗi RAM"
            }
          }
        ]
      },
      "metadata": {
        "skill": "format_report",
        "difficulty": "medium",
        "what_it_tests": "Chỉ format báo cáo nếu đã có findings, không gọi thêm tool."
      }
    },
    {
