      "suite": "group",
      "query": "Tìm tài liệu xử lý lỗi âm thanh phòng họp.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "search_kb",
            "args": {
              "category": "meeting_room"
            }
          }
        ]
      },
      "metadata": {
        "skill": "kb_routing",
        "difficulty": "easy",
        "what_it_tests": "Định tuyến tài liệu phòng họp vào đúng category local mà không gọi external search."
      }
    },
